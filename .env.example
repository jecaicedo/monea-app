# Copia este archivo como .env y reemplaza los valores por los de tu proyecto.
# Dashboard de Supabase -> Project Settings -> API
#
# Vite solo expone al navegador las variables que empiezan por VITE_,
# y solo las lee al arrancar: si cambias el .env, reinicia `npm run dev`.

# URL del proyecto, ej. https://abcdefghijklm.supabase.co
VITE_SUPABASE_URL=

# Llave "anon public". Es publica por diseno; lo que protege los datos son las
# politicas RLS. NUNCA pongas aqui la llave service_role.
VITE_SUPABASE_ANON_KEY=
